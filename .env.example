# App
APP_NAME="Skill Orbit API"
APP_ENV=local
API_V1_PREFIX=/api/v1

# CORS
# Add your frontend origins when you move the HTML app behind a dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Future persistence / AI integration hooks
DATABASE_URL=sqlite:///./skill_orbit.db
OPENAI_API_KEY=

# Auth
AUTH_SECRET_KEY=change-this-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
